<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#050706">
    <meta name="description" content="{{ description or site.description }}">
    <meta name="color-scheme" content="dark">
    <title>{{ title }}{% if title != site.name %} — {{ site.name }}{% endif %}</title>
    <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
    <link rel="icon" href="{{ "/favicon.svg" | url }}" type="image/svg+xml">
    <link rel="manifest" href="{{ "/site.webmanifest" | url }}">
    <link rel="stylesheet" href="{{ "/assets/css/style.css" | url }}">
    <script src="{{ "/assets/js/main.js" | url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {{ content | safe }}
  </body>
</html>
